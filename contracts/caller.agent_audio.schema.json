{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "unit_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Unit Id",
      "type": "string"
    },
    "pcm_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pcm Sha256",
      "type": "string"
    },
    "audio_retained": {
      "title": "Audio Retained",
      "type": "boolean"
    },
    "sample_rate": {
      "minimum": 0,
      "title": "Sample Rate",
      "type": "integer"
    }
  },
  "required": [
    "unit_id",
    "pcm_sha256",
    "audio_retained",
    "sample_rate"
  ],
  "title": "CallerAgentAudio",
  "type": "object"
}
