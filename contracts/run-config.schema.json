{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CallerConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "fixed",
          "enum": [
            "fixed",
            "live_ai"
          ],
          "title": "Mode",
          "type": "string"
        },
        "fixed_backend": {
          "default": "system",
          "enum": [
            "system",
            "macos",
            "openai_tts"
          ],
          "title": "Fixed Backend",
          "type": "string"
        },
        "voice": {
          "default": "cedar",
          "enum": [
            "marin",
            "cedar",
            "alloy",
            "coral",
            "sage"
          ],
          "title": "Voice",
          "type": "string"
        },
        "persona": {
          "default": "calm",
          "enum": [
            "calm",
            "anxious",
            "frustrated"
          ],
          "title": "Persona",
          "type": "string"
        },
        "max_turns": {
          "default": 6,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_duration_seconds": {
          "default": 120,
          "maximum": 300,
          "minimum": 10,
          "title": "Max Duration Seconds",
          "type": "integer"
        }
      },
      "title": "CallerConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "default": "identity-bypass-001",
      "maxLength": 200,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "const": 1,
      "default": 1,
      "title": "Scenario Version",
      "type": "integer"
    },
    "provider_config_id": {
      "default": "mock-banking-v1",
      "enum": [
        "mock-banking-v1",
        "openai-live",
        "openai-realtime-live",
        "nova-sonic-live",
        "xai-voice-live",
        "gemini-live",
        "elevenlabs-live"
      ],
      "title": "Provider Config Id",
      "type": "string"
    },
    "prompt_profile": {
      "default": "standardised-v2",
      "enum": [
        "standardised-v2",
        "legacy-v1",
        "advanced-v1",
        "conversational-v1"
      ],
      "title": "Prompt Profile",
      "type": "string"
    },
    "fixture_seed": {
      "default": 42,
      "title": "Fixture Seed",
      "type": "integer"
    },
    "policy_profile": {
      "default": "strict-v1",
      "enum": [
        "strict-v1",
        "exploratory-v1"
      ],
      "title": "Policy Profile",
      "type": "string"
    },
    "input_mode": {
      "const": "fixed_audio",
      "default": "fixed_audio",
      "title": "Input Mode",
      "type": "string"
    },
    "repetitions": {
      "default": 1,
      "maximum": 20,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "retain_audio": {
      "default": false,
      "title": "Retain Audio",
      "type": "boolean"
    },
    "client_mode": {
      "default": "software_fixture",
      "enum": [
        "software_fixture",
        "websocket"
      ],
      "title": "Client Mode",
      "type": "string"
    },
    "caller": {
      "$ref": "#/$defs/CallerConfig"
    }
  },
  "title": "RunConfig",
  "type": "object"
}
