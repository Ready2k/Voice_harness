{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "source": {
      "const": "provider_input_transcription",
      "title": "Source",
      "type": "string"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Item Id"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Sha256",
      "type": "string"
    }
  },
  "required": [
    "source",
    "item_id",
    "text",
    "text_sha256"
  ],
  "title": "InputCallerTranscript",
  "type": "object"
}
