{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FindingRecord": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "criterion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "criterion_version": {
          "minimum": 1,
          "title": "Criterion Version",
          "type": "integer"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "untestable",
            "evaluation_error"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "modality": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "title": "Rationale",
          "type": "string"
        },
        "confidence_source": {
          "enum": [
            "deterministic",
            "judge_self_reported",
            "human"
          ],
          "title": "Confidence Source",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "uncertainty": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty"
        },
        "abstained": {
          "title": "Abstained",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation_errors": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Validation Errors",
          "type": "array"
        },
        "rejected_citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Citation Ids",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "judge_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Judge Id"
        }
      },
      "required": [
        "finding_id",
        "criterion_id",
        "criterion_version",
        "verdict",
        "severity",
        "evidence_event_ids",
        "modality",
        "rationale",
        "confidence_source",
        "confidence",
        "score",
        "uncertainty",
        "abstained",
        "status",
        "validation_errors",
        "rejected_citation_ids",
        "reason_codes",
        "judge_id"
      ],
      "title": "FindingRecord",
      "type": "object"
    },
    "JudgeIdentity": {
      "additionalProperties": false,
      "properties": {
        "judge_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Judge Id",
          "type": "string"
        },
        "backend": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "provider": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "family": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "prompt_template_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Prompt Template Id",
          "type": "string"
        },
        "evaluation_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evaluation Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "vendor": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor"
        }
      },
      "required": [
        "judge_id",
        "backend",
        "provider",
        "model_id",
        "family",
        "prompt_template_id",
        "evaluation_version",
        "session_id"
      ],
      "title": "JudgeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "judge": {
      "$ref": "#/$defs/JudgeIdentity"
    },
    "status": {
      "enum": [
        "ok",
        "evaluation_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/FindingRecord"
      },
      "title": "Results",
      "type": "array"
    },
    "abstained_criteria": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Abstained Criteria",
      "type": "array"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "temperature_fallback": {
      "default": false,
      "title": "Temperature Fallback",
      "type": "boolean"
    },
    "model_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    }
  },
  "required": [
    "evaluation_id",
    "judge",
    "status",
    "error_code",
    "results",
    "abstained_criteria",
    "latency_ms"
  ],
  "title": "JudgeOfflineEvaluated",
  "type": "object"
}
