    },
    "setup_ms": {
      "minimum": 0,
      "title": "Setup Ms",
      "type": "integer"
    },
    "started_ms": {
      "minimum": 0,
      "title": "Started Ms",
      "type": "integer"
    },
    "ready_ms": {
      "minimum": 0,
      "title": "Ready Ms",
      "type": "integer"
    },
    "clock_domain_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Clock Domain Id",
      "type": "string"
