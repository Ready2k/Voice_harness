{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "turn": {
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    },
    "source_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Text Sha256",
      "type": "string"
    },
    "pcm_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pcm Sha256",
      "type": "string"
    },
    "byte_count": {
      "minimum": 0,
      "title": "Byte Count",
      "type": "integer"
    },
    "sample_rate": {
      "minimum": 0,
      "title": "Sample Rate",
      "type": "integer"
    },
    "audio_retained": {
      "title": "Audio Retained",
      "type": "boolean"
    },
    "transformations": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Transformations",
      "type": "array"
    },
    "stream_started_ms": {
      "minimum": 0,
      "title": "Stream Started Ms",
      "type": "integer"
    },
    "stream_ended_ms": {
      "minimum": 0,
      "title": "Stream Ended Ms",
      "type": "integer"
    },
    "clock_domain_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Clock Domain Id",
      "type": "string"
    },
    "speech_ended_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speech Ended Ms"
    },
    "turn_signal_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Signal Ms"
    },
    "turn_commit": {
      "anyOf": [
        {
          "enum": [
            "explicit",
            "provider_vad",
            "automatic"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Commit"
    },
    "commit_delay_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Delay Ms"
    },
    "streamed_byte_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Streamed Byte Count"
    }
  },
  "required": [
    "turn",
    "source_text_sha256",
    "pcm_sha256",
    "byte_count",
    "sample_rate",
    "audio_retained",
    "transformations",
    "stream_started_ms",
    "stream_ended_ms",
    "clock_domain_id"
  ],
  "title": "InputCallerAudio",
  "type": "object"
}
