{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "content_hash": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "version",
    "text",
    "content_hash"
  ],
  "title": "PolicyResult",
  "type": "object"
}
