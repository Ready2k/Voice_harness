{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "number"
    },
    "run_wide": {
      "const": true,
      "default": true,
      "title": "Run Wide",
      "type": "boolean"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "reason",
    "owner_id",
    "expires_at",
    "idempotency_key"
  ],
  "title": "HoldRequest",
  "type": "object"
}
