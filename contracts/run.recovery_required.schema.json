{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generation_epoch": {
      "minimum": 0,
      "title": "Generation Epoch",
      "type": "integer"
    },
    "reason": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "tool_outcomes": {
      "additionalProperties": true,
      "title": "Tool Outcomes",
      "type": "object"
    }
  },
  "required": [
    "generation_epoch",
    "reason",
    "tool_outcomes"
  ],
  "title": "RunRecoveryRequired",
  "type": "object"
}
