  "components": {
    "schemas": {
      "CancelRun": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "default": "operator_request"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CancelRun"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          },
          "owner_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Owner Id"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "run_wide": {
            "type": "boolean",
            "const": true,
            "title": "Run Wide",
            "default": true
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason",
          "owner_id",
          "expires_at",
          "idempotency_key"
        ],
        "title": "HoldRequest"
      },
      "RenewHold": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason",
          "expires_at"
        ],
        "title": "RenewHold"
      },
      "RunConfig": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "enum": [
              "identity-bypass-001",
              "balance-verified-001",
              "unsafe-disclosure-001"
            ],
            "title": "Scenario Id",
            "default": "identity-bypass-001"
          },
          "scenario_version": {
            "type": "integer",
            "const": 1,
            "title": "Scenario Version",
            "default": 1
          },
          "provider_config_id": {
            "type": "string",
            "const": "mock-banking-v1",
            "title": "Provider Config Id",
            "default": "mock-banking-v1"
          },
          "fixture_seed": {
            "type": "integer",
            "title": "Fixture Seed",
            "default": 42
          },
          "policy_profile": {
            "type": "string",
            "enum": [
              "strict-v1",
              "exploratory-v1"
            ],
            "title": "Policy Profile",
            "default": "strict-v1"
          },
          "input_mode": {
            "type": "string",
            "const": "fixed_audio",
            "title": "Input Mode",
            "default": "fixed_audio"
          },
          "repetitions": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Repetitions",
            "default": 1
          },
          "retain_audio": {
            "type": "boolean",
            "title": "Retain Audio",
            "default": false
          },
          "client_mode": {
            "type": "string",
            "enum": [
              "software_fixture",
              "websocket"
            ],
            "title": "Client Mode",
            "default": "software_fixture"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunConfig"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
