{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "queue": {
      "enum": [
        "fraud",
        "support",
        "vulnerable_customer"
      ],
      "title": "Queue",
      "type": "string"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "queue",
    "reason"
  ],
  "title": "HandoffArgs",
  "type": "object"
}
