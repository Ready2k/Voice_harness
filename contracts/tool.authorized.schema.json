{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Call Id",
      "type": "string"
    },
    "argument_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Argument Hash",
      "type": "string"
    },
    "identity_state_version": {
      "minimum": 0,
      "title": "Identity State Version",
      "type": "integer"
    }
  },
  "required": [
    "call_id",
    "argument_hash",
    "identity_state_version"
  ],
  "title": "ToolAuthorized",
  "type": "object"
}
