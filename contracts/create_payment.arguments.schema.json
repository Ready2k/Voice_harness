{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Account Id",
      "type": "string"
    },
    "payee_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Payee Id",
      "type": "string"
    },
    "amount_minor": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Amount Minor",
      "type": "integer"
    },
    "currency": {
      "const": "GBP",
      "title": "Currency",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "payee_id",
    "amount_minor",
    "currency"
  ],
  "title": "PaymentArgs",
  "type": "object"
}
