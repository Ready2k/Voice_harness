{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "from_state": {
      "const": "open",
      "title": "From State",
      "type": "string"
    },
    "to_state": {
      "const": "in_review",
      "title": "To State",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "reviewer_id",
    "from_state",
    "to_state"
  ],
  "title": "ReviewClaimed",
  "type": "object"
}
