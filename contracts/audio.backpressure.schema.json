{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failure_code": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Failure Code",
      "type": "string"
    },
    "buffered_bytes": {
      "minimum": 0,
      "title": "Buffered Bytes",
      "type": "integer"
    },
    "incoming_bytes": {
      "minimum": 0,
      "title": "Incoming Bytes",
      "type": "integer"
    },
    "limit_bytes": {
      "minimum": 0,
      "title": "Limit Bytes",
      "type": "integer"
    },
    "discarded_unit_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Discarded Unit Ids",
      "type": "array"
    },
    "generation_epoch": {
      "minimum": 0,
      "title": "Generation Epoch",
      "type": "integer"
    },
    "provider_cancellation": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Provider Cancellation",
      "type": "string"
    },
    "fallback_audio": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Fallback Audio",
      "type": "string"
    }
  },
  "required": [
    "failure_code",
    "buffered_bytes",
    "incoming_bytes",
    "limit_bytes",
    "discarded_unit_ids",
    "generation_epoch",
    "provider_cancellation",
    "fallback_audio"
  ],
  "title": "AudioBackpressure",
  "type": "object"
}
